```env
# ============================================================
# Meridian Solutions | Environment Configuration Example
# Copy this file to .env and replace the placeholder values.
# Do not commit your real .env file to GitHub.
# ============================================================

# ------------------------------------------------------------
# SQL Server connection
# ------------------------------------------------------------

# SQL Server host or instance name
# Examples:
# DB_SERVER=localhost
# DB_SERVER=localhost\SQLEXPRESS
# DB_SERVER=DESKTOP-12345\SQLEXPRESS
DB_SERVER=localhost

# SQL Server database name
DB_NAME=MeridianOps

# ------------------------------------------------------------
# Monitor account
# Used by monitor.py
# Requires permission to:
# - Read hosts
# - Insert uptime logs
# - Create and update incidents
# ------------------------------------------------------------

DB_USER=NetworkMonitor
DB_PASSWORD=<replace_with_network_monitor_password>

# ------------------------------------------------------------
# Optional dashboard read-only account
# Used by streamlit/dashboard.py
# If these are not set, the dashboard falls back to DB_USER/DB_PASSWORD.
# ------------------------------------------------------------

DB_DASHBOARD_USER=ReadOnlyUser
DB_DASHBOARD_PASSWORD=<replace_with_readonly_password>
```

```env
# ============================================================
# Meridian Solutions | Environment Configuration Example
# Copy this file to .env and replace the placeholder values.
# Do not commit your real .env file to GitHub.
# ============================================================

# SQL Server host or instance name
# Examples:
# DB_SERVER=localhost
# DB_SERVER=localhost\SQLEXPRESS
# DB_SERVER=DESKTOP-12345\SQLEXPRESS
DB_SERVER=localhost

# SQL Server database name
DB_NAME=MeridianOps

# SQL Server login used by monitor.py
DB_USER=NetworkMonitor

# Password for the NetworkMonitor SQL login
DB_PASSWORD=<replace_with_secure_password>
```
